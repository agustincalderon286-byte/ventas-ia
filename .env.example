# Mis conexiones: piloto Gmail de solo lectura (credenciales independientes).
COACH_CONNECTIONS_PILOT_EMAILS=calderonrigoberto51@gmail.com
COACH_GMAIL_CLIENT_ID=
COACH_GMAIL_CLIENT_SECRET=
# Clave estable de 32 bytes en base64, guardada como secreto en el servidor.
COACH_GMAIL_ENCRYPTION_KEY=
COACH_HYCITE_DOMAINS=hycite.com

# Piloto WhatsApp Business Cloud API (coexistencia): UN vendedor y UNA línea.
# Solo secretos del servidor del dueño de TEC; el cliente nunca aporta token, remitente ni destinatario final.
# Email exacto del vendedor (sin comodines ni listas) y número exacto de su línea con + y prefijo.
# Coach verifica con Graph que display_phone_number del ID coincida antes de cada envío.
# No puede ser el número de TWILIO_WHATSAPP_FROM / TWILIO_SMS_FROM / WHATSAPP_CHEF_NUMBER.
# Requiere también COACH_GMAIL_ENCRYPTION_KEY (cifra los borradores). Vacío = flujo manual para todos.
COACH_WA_CLOUD_SELLER_EMAIL=
COACH_WA_CLOUD_PHONE=
COACH_WA_CLOUD_PHONE_NUMBER_ID=
COACH_WA_CLOUD_ACCESS_TOKEN=
COACH_WA_CLOUD_GRAPH_VERSION=v27.0
# Webhook oficial de Meta para la ventana de 24 horas: GET/POST /webhooks/coach/meta-whatsapp.
# Usa el mismo COACH_WA_CLOUD_PHONE_NUMBER_ID de arriba (no hay otra variable para la línea).
# Sin secreto o sin mensajes auténticos recientes, Coach trata la ventana como cerrada y no envía texto libre.
COACH_WA_META_APP_SECRET=
COACH_WA_WEBHOOK_VERIFY_TOKEN=
# Plantilla opcional para fuera de las 24 horas: UTILITY aprobada en Meta, solo un BODY de texto fijo
# (sin variables, encabezado ni botones). Coach nunca crea ni edita plantillas. Vacío = sin envío fuera de la ventana.
COACH_WA_CLOUD_WABA_ID=
COACH_WA_CLOUD_TEMPLATE_NAME=
COACH_WA_CLOUD_TEMPLATE_LANGUAGE=

# Asistente con ciclo de herramientas (lecturas). Lista de correos separados por coma; vacío = apagado para todos.
# Antes de activarlo para un vendedor hace falta su consentimiento en Mis conexiones.
COACH_AGENT_LOOP_EMAILS=
# Límite mensual por vendedor en millonésimas de dólar (5000000 = 5 USD).
COACH_AGENT_LOOP_MONTHLY_MICROS=5000000
# Administradores de la Torre que pueden leer las conversaciones del Coach (separados por coma). Vacío: nadie.
COACH_CHAT_REVIEW_EMAILS=
# Voz bilingüe a prueba: solo estas cuentas la oyen; las demás siguen con Jorge. Vacío = nadie.
COACH_VOICE_TRIAL_EMAILS=
COACH_VOICE_TRIAL_NAME=es-MX-JorgeMultilingualNeural
